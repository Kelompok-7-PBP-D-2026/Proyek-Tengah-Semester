# Contoh env lokal — salin jadi .env (gitignored), isi nilainya sendiri.
# DI PWS nilai ini diisi lewat tab Environs, bukan file.
DEBUG=True
SECRET_KEY=change-me
# PRODUCTION=True mengaktifkan PostgreSQL (PWS). Lokal: biarkan kosong/False.
# PRODUCTION=True
# DB_NAME=<nama database>
# DB_USER=<user database>
# DB_PASSWORD=<password database>
# DB_HOST=<host database>
# DB_PORT=<port database>
# SCHEMA=tugas_kelompok
# PWS_DEPLOY_URL=<sso-owner>-pts-surplus.pws.cs.ui.ac.id
